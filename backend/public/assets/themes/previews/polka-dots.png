<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <rect width="200" height="200" fill="#ffffff"/>
  <circle cx="10" cy="10" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="30" cy="30" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="50" cy="10" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="70" cy="30" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="90" cy="10" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="110" cy="30" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="130" cy="10" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="150" cy="30" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="170" cy="10" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="190" cy="30" r="3" fill="#d4a5a5" opacity="0.15"/>
  <!-- Repeat pattern -->
  <circle cx="10" cy="50" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="30" cy="70" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="50" cy="50" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="70" cy="70" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="90" cy="50" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="110" cy="70" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="130" cy="50" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="150" cy="70" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="170" cy="50" r="3" fill="#d4a5a5" opacity="0.15"/>
  <circle cx="190" cy="70" r="3" fill="#d4a5a5" opacity="0.15"/>
  <text x="100" y="100" font-family="Arial" font-size="14" fill="#d4a5a5" text-anchor="middle" dominant-baseline="middle">Polka Dots</text>
</svg>