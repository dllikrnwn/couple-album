<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fff5f8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fff5f8;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="200" height="200" fill="#fff5f8"/>
  <defs>
    <pattern id="floral" patternUnits="userSpaceOnUse" width="60" height="60">
      <circle cx="30" cy="30" r="8" fill="#d4a5a5" opacity="0.15"/>
    </pattern>
  </defs>
  <rect width="200" height="200" fill="#fff5f8" fill-opacity="1"/>
  <rect width="200" height="200" fill="url(#floral)" fill-opacity="0.3"/>
  <text x="100" y="100" font-family="Arial" font-size="14" fill="#d4a5a5" text-anchor="middle" dominant-baseline="middle">Floral Pink</text>
</svg>